    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const gem = $input.item.json;\nconst dados = $('Code in JavaScript').item.json;\n\nlet ia = null;\ntry {\n  const parte = gem.content.parts.find(p => p.text);\n  const texto = parte.text.replace(/```json|```/g, '').trim();\n  ia = JSON.parse(texto);\n} catch (e) {\n  ia = null;\n}\n\nconst iaOk = !!ia && (ia.risco === 'baixo' || ia.risco === 'alto');\n\nreturn {\n  json: {\n    ...dados,\n    ia_ok: iaOk,\n    risco_ia: iaOk ? ia.risco : null,\n    justificativa_ia: iaOk\n      ? ia.justificativa\n      : 'A análise de risco falhou; pedido enviado para revisão humana.',\n    sinais_ia: iaOk && Array.isArray(ia.sinais) ? ia.sinais : []\n  }\n};"
      },
